APP_NAME=Lighting Panel API
ENVIRONMENT=development
API_PREFIX=/api/v1
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://lighting:change-me@localhost:5432/lighting_panel
ACCESS_TOKEN_MINUTES=20
CORS_ORIGINS=http://localhost:5173

FRONTEND_URL=https://panel.example.com
# Stripe recurring Price ID, API secret key and webhook signing secret (keep private).
STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RATE_LIMIT_PER_MINUTE=180
